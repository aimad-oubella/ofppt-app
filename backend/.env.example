APP_NAME="OFPPT Gestion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ofppt_gestion
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Authentification SPA (Sanctum) : le frontend Vite tourne sur le port 5173
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Premier compte administrateur (utilisé uniquement par le seeder).
# Renseignez ces deux valeurs dans votre .env local, jamais dans ce fichier.
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phase 4 : chemin de soffice.exe pour la conversion DOCX -> PDF (optionnel)
LIBREOFFICE_PATH=
